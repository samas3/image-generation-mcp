{
  "name": "image-generation-mcp",
  "displayName": "Image Generation MCP",
  "description": "Provides configurable image generation capabilities using MCP Service for VS Code Copilot.",
  "version": "0.0.1",
  "publisher": "samas3",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "image-generation-mcp.generateImage",
        "title": "Generate Image",
        "category": "Image Generation MCP"
      },
      {
        "command": "image-generation-mcp.configureApiKey",
        "title": "Configure Image Provider API Key",
        "category": "Image Generation MCP"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "image-generation-mcp",
        "label": "Image Generation MCP"
      }
    ],
    "configuration": {
      "title": "Image Generation MCP",
      "properties": {
        "imageGenerationMcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Image Generation MCP service for VS Code Copilot."
        },
        "imageGenerationMcp.endpoint": {
          "type": "string",
          "default": "",
          "description": "Image generation endpoint compatible with the OpenAI Images API. Configure an API key separately with the extension command."
        },
        "imageGenerationMcp.model": {
          "type": "string",
          "default": "gpt-image-1",
          "description": "Image generation model or provider-specific model name."
        },
        "imageGenerationMcp.defaultWidth": {
          "type": "number",
          "minimum": 64,
          "maximum": 2048,
          "default": 512,
          "description": "Default width in pixels."
        },
        "imageGenerationMcp.defaultHeight": {
          "type": "number",
          "minimum": 64,
          "maximum": 2048,
          "default": 512,
          "description": "Default height in pixels."
        },
        "imageGenerationMcp.defaultFormat": {
          "type": "string",
          "enum": ["png", "jpeg"],
          "default": "png",
          "description": "Default image format."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
